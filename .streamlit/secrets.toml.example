# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is git-ignored, so your key never reaches GitHub.

# From https://resend.com/api-keys
RESEND_API_KEY = "re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Where alerts are sent. Without a verified domain, Resend only delivers
# to the email address you signed up to Resend with.
ALERT_EMAIL_TO = "you@example.com"

# Optional. The default works without verifying a domain.
# ALERT_EMAIL_FROM = "Portfolio Analyzer <onboarding@resend.dev>"
